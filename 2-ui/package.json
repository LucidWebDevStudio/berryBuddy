{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "config": {
    "region": "eu-north-1",
    "appBucket": "berry-buddy---app-bucket",
    "distributionId": "E1EBUNQ38QDSVA"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deleteobjectsins3": "aws s3 rm s3://$npm_package_config_appBucket --recursive",
    "copytos3": "aws s3 cp dist s3://$npm_package_config_appBucket --recursive",
    "invalidate-cf-cache": "aws cloudfront create-invalidation --distribution-id $npm_package_config_distributionId --paths '/*'",
    "deploy": "npm run build && npm run deleteobjectsins3 && npm run copytos3 && npm run invalidate-cf-cache"
  },
  "dependencies": {
    "@aws-amplify/auth": "^6.17.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.17",
    "aws-amplify": "^6.15.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.556.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.10.1",
    "react-textarea-autosize": "^8.5.9",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
